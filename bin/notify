#!/usr/bin/env bash
# notify: send myself a short notification.
#
#   notify [-l] [-p low|default|high|urgent] [-t TAG] TITLE [BODY]
#
# Delivers to every channel this machine has:
#   - the desktop: terminal-notifier or osascript on macOS, notify-send on Linux
#   - ntfy, when ~/.notify.local sets NTFY_URL (see notify.local.example);
#     the title is prefixed with the host name so remote pushes say where
#
# TAG is an ntfy tag (an emoji short code such as x or white_check_mark).
# -l rings only this desktop and skips ntfy, for news another machine
# already pushed.
# Exits 1 when nothing could deliver.
set -euo pipefail

priority=default
tag=""
local_only=0
while getopts "lp:t:" opt; do
  case "$opt" in
    l) local_only=1 ;;
    p) priority="$OPTARG" ;;
    t) tag="$OPTARG" ;;
    *) echo "usage: notify [-l] [-p PRIORITY] [-t TAG] TITLE [BODY]" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -ge 1 ]] || { echo "usage: notify [-l] [-p PRIORITY] [-t TAG] TITLE [BODY]" >&2; exit 2; }
title="$1"
body="${2:-}"

# shellcheck disable=SC1090
[[ -f "$HOME/.notify.local" ]] && . "$HOME/.notify.local"

delivered=0

case "$(uname -s)" in
  Darwin)
    # terminal-notifier (brew) shows as its own app with banners and groups
    # repeats by title; osascript works out of the box but reports as
    # Script Editor, whose alerts land only in Notification Center.
    if command -v terminal-notifier >/dev/null; then
      terminal-notifier -title "$title" -message "${body:-$title}" -group "$title" >/dev/null 2>&1 && delivered=1
    elif osascript -e 'on run argv' \
                 -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
                 -e 'end run' "$title" "$body" 2>/dev/null; then
      delivered=1
    fi
    ;;
  Linux)
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v notify-send >/dev/null; then
      urgency=normal
      case "$priority" in low|min) urgency=low ;; high|urgent|max) urgency=critical ;; esac
      notify-send -u "$urgency" "$title" "$body" 2>/dev/null && delivered=1
    fi
    ;;
esac

if [[ -n "${NTFY_URL:-}" && $local_only -eq 0 ]]; then
  headers=(-H "Title: [$(hostname -s)] $title" -H "Priority: $priority")
  [[ -n "$tag" ]] && headers+=(-H "Tags: $tag")
  [[ -n "${NTFY_TOKEN:-}" ]] && headers+=(-H "Authorization: Bearer $NTFY_TOKEN")
  if curl -fsS -m 10 -o /dev/null "${headers[@]}" -d "$body" "$NTFY_URL"; then
    delivered=1
  else
    echo "notify: ntfy push failed" >&2
  fi
fi

if (( delivered == 0 )); then
  echo "notify: no channel delivered: $title" >&2
  exit 1
fi
