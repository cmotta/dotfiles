#!/usr/bin/env bash
# claude-teleport: move a Claude Code session to another machine's Rex server.
#
#   claude-teleport [-d DIR] [-i SESSION_ID] [-s SSH_HOST] [-y] [-n] [-f] HOST
#
# Takes the newest session recorded for the current folder (or -i), copies
# its transcript to HOST and opens a new Rex session there that resumes it.
# HOST is a Rex host label (rex hosts); files go over ssh to SSH_HOST, which
# defaults to HOST.
#
# Without -d it looks on HOST for the folder and asks which one to use:
#   - the same path relative to $HOME,
#   - checkouts of the same git origin (the same subfolder inside them),
#   - else the nearest existing parent of the same path.
# Enter takes the first, a number picks one, anything else is a path on HOST.
# -y takes the first without asking, only if it is an exact match.
#
# Paths under the old folder are rewritten to the new one in the transcript,
# other paths under $HOME to HOST's home, and the first prompt tells the
# model it moved. Refuses when the local repo has uncommitted or unpushed
# work, when HOST's checkout is at another commit, or when HOST already has
# the session (-f overrides all three). -n stops before copying and leaves
# the rewritten transcript in a temp dir.
#
# Quit the local session first, or the two copies will diverge.
set -euo pipefail

usage() { echo "usage: claude-teleport [-d DIR] [-i SESSION_ID] [-s SSH_HOST] [-y] [-n] [-f] HOST" >&2; exit 2; }

remote_dir="" id="" ssh_host="" yes=0 dry=0 force=0
while getopts "d:i:s:ynfh" opt; do
  case "$opt" in
    d) remote_dir="$OPTARG" ;;
    i) id="$OPTARG" ;;
    s) ssh_host="$OPTARG" ;;
    y) yes=1 ;;
    n) dry=1 ;;
    f) force=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -eq 1 ]] || usage
host="$1"
ssh_host="${ssh_host:-$host}"

die() { echo "claude-teleport: $*" >&2; exit 1; }
refuse() { if (( force )); then echo "claude-teleport: warning: $*" >&2; else die "$* (-f to go anyway)"; fi; }
enc() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
q() { printf %q "$1"; }
rsh() { ssh -o BatchMode=yes "$ssh_host" "$@"; }

src="$(pwd -P)"
projects="$HOME/.claude/projects"
src_proj="$projects/$(enc "$src")"
[[ -d "$src_proj" ]] || die "no Claude sessions recorded for $src"

if [[ -z "$id" ]]; then
  newest="$(ls -t "$src_proj"/*.jsonl 2>/dev/null | head -1 || true)"
  [[ -n "$newest" ]] || die "no Claude sessions recorded for $src"
  id="$(basename "$newest" .jsonl)"
fi
transcript="$src_proj/$id.jsonl"
[[ -f "$transcript" ]] || die "no session $id in $src_proj"

# Local repo: everything the session saw must be reachable from HOST.
local_head="" origin="" inner=""
if git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
  local_head="$(git -C "$src" rev-parse HEAD)"
  origin="$(git -C "$src" remote get-url origin 2>/dev/null || true)"
  inner="$(git -C "$src" rev-parse --show-prefix)"
  inner="${inner%/}"
  [[ -z "$(git -C "$src" status --porcelain)" ]] || refuse "$src has uncommitted changes"
  [[ -n "$(git -C "$src" branch -r --contains HEAD 2>/dev/null)" ]] || refuse "HEAD of $src is not pushed"
fi
rel=""
[[ "$src" == "$HOME"/* ]] && rel="${src#"$HOME"/}"

# One round trip: HOST's home and the candidate folders, tagged.
probe() {
  cat <<'SH'
set -eu
rel="$1" origin="$2" inner="$3"
norm() { printf '%s\n' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#:#/#; s#/+$##; s#\.git$##'; }
echo "HOME $HOME"
exact=0
if [ -n "$rel" ] && [ -d "$HOME/$rel" ]; then echo "SAME $(cd "$HOME/$rel" && pwd -P)"; exact=1; fi
if [ -n "$origin" ]; then
  want="$(norm "$origin")"
  find "$HOME" -maxdepth 5 \( -name node_modules -o -name .cache -o -name .local -o -name .claude -o -name Library \) -prune \
    -o -name .git -print 2>/dev/null | while read -r g; do
    d="${g%/.git}"
    u="$(git -C "$d" remote get-url origin 2>/dev/null)" || continue
    [ "$(norm "$u")" = "$want" ] || continue
    if [ -n "$inner" ] && [ -d "$d/$inner" ]; then echo "REPO $d/$inner"; else echo "REPO $d"; fi
  done
fi
if [ "$exact" = 0 ] && [ -n "$rel" ]; then
  p="$HOME/$rel"
  while [ ! -d "$p" ]; do p="$(dirname "$p")"; done
  echo "NEAR $p"
fi
SH
}

found="$(probe | rsh "sh -s -- $(q "$rel") $(q "$origin") $(q "$inner")")" || die "cannot reach $ssh_host over ssh"
remote_home="$(sed -n 's/^HOME //p' <<<"$found")"
[[ -n "$remote_home" ]] || die "cannot read \$HOME on $ssh_host"

tilde() { [[ "$1" == "$remote_home" || "$1" == "$remote_home"/* ]] && printf '~%s' "${1#"$remote_home"}" || printf '%s' "$1"; }
untilde() { [[ "$1" == "~" || "$1" == "~/"* ]] && printf '%s%s' "$remote_home" "${1#\~}" || printf '%s' "$1"; }
resolve() { rsh "cd $(q "$(untilde "$1")") 2>/dev/null && pwd -P"; }

if [[ -n "$remote_dir" ]]; then
  remote_dir="$(resolve "$remote_dir")" || die "$remote_dir does not exist on $host"
else
  cands=() why=()
  while read -r tag path; do
    [[ "$tag" == HOME || -z "$path" ]] && continue
    dup=0
    for c in "${cands[@]+"${cands[@]}"}"; do [[ "$c" == "$path" ]] && dup=1; done
    (( dup )) && continue
    cands+=("$path")
    case "$tag" in
      SAME) why+=("same path") ;;
      REPO) why+=("same git origin") ;;
      NEAR) why+=("nearest parent that exists") ;;
    esac
  done <<<"$found"

  if (( yes )) || [[ ! -t 0 ]]; then
    [[ ${#cands[@]} -gt 0 && "${why[0]}" != nearest* ]] || die "no matching folder on $host, pass -d"
    remote_dir="${cands[0]}"
  else
    t='~'
    echo "Folder on $host for ${src/#"$HOME"/$t}:" >&2
    for i in "${!cands[@]}"; do
      printf '  %d) %-40s %s\n' $((i + 1)) "$(tilde "${cands[$i]}")" "${why[$i]}" >&2
    done
    while :; do
      if (( ${#cands[@]} )); then
        range=1; (( ${#cands[@]} > 1 )) && range="1-${#cands[@]}"
        read -r -p "Pick $range or type a path [1]: " answer
      else
        read -r -p "Path on $host: " answer
      fi
      if [[ -z "$answer" && ${#cands[@]} -gt 0 ]]; then
        remote_dir="${cands[0]}"
      elif [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#cands[@]} )); then
        remote_dir="${cands[$((answer - 1))]}"
      elif [[ -n "$answer" ]] && remote_dir="$(resolve "$answer")"; then
        :
      else
        echo "  not a folder on $host: $answer" >&2
        continue
      fi
      break
    done
  fi
fi

if [[ -n "$local_head" ]]; then
  branch="$(git -C "$src" symbolic-ref -q --short HEAD || true)"
  if [[ -n "$branch" ]]; then
    fix="git fetch -q && git switch -q $branch && git merge -q --ff-only origin/$branch"
  else
    fix="git fetch -q && git checkout -q $local_head"
  fi
  remote_head="$(rsh "git -C $(q "$remote_dir") rev-parse HEAD 2>/dev/null" || true)"
  [[ "$remote_head" == "$local_head" ]] ||
    refuse "$host:$(tilde "$remote_dir") is at ${remote_head:0:7}, not ${local_head:0:7}; update it with: ssh $ssh_host 'cd $(q "$remote_dir") && $fix'"
fi

dst_proj="$remote_home/.claude/projects/$(enc "$remote_dir")"
if rsh "test -e $(q "$dst_proj/$id.jsonl")"; then
  refuse "$host already has session $id"
fi

tmp="$(mktemp -d)"
(( dry )) || trap 'rm -rf "$tmp"' EXIT
python3 -I - "$transcript" "$tmp/$id.jsonl" "$src" "$remote_dir" "$HOME" "$remote_home" <<'PY'
import sys
src_file, dst_file, old, new, old_home, new_home = sys.argv[1:]
with open(src_file, encoding="utf-8") as f:
    text = f.read()
# The folder first, so the chosen folder wins over the plain home mapping.
text = text.replace(old, new).replace(old_home + "/", new_home + "/")
text = text.replace('"cwd":"' + old_home + '"', '"cwd":"' + new_home + '"')
with open(dst_file, "w", encoding="utf-8") as f:
    f.write(text)
PY

note="This session was moved from $(hostname -s):$src to $host:$remote_dir with claude-teleport. Paths in earlier turns were rewritten to this machine. Files outside the folder, tools only the old machine had and local MCP servers may not exist here. Check git status and confirm where we are before continuing."

cat <<EOF
session   $id
from      $src
to        $host:$remote_dir
EOF

if (( dry )); then
  echo "dry run: rewritten transcript in $tmp/$id.jsonl"
  exit 0
fi

rsh "mkdir -p $(q "$dst_proj")"
scp -q "$tmp/$id.jsonl" "$ssh_host:$(q "$dst_proj/")"
if [[ -d "$src_proj/$id" ]]; then scp -qr "$src_proj/$id" "$ssh_host:$(q "$dst_proj/")"; fi

rex -S "$host" new "$(basename "$remote_dir")" -c "$remote_dir" -- claude --resume "$id" "$note"
echo "resumed on $host. quit the local session if it is still open."
