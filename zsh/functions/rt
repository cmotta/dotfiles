# Open a tab in a Rex session from wherever you are.
#
#   rt                        # new tab here, in the current session
#   rt ed                     # new tab here, in session ed (created if new)
#   rt ed ~/Code/attom-agent  # ... starting in that directory
#   rt . ~/Code/x dev         # current session, that directory, "dev" layout
#
# Layouts live in config/rex/layouts.lua. Delegates to the `open` action.

function rt() {
  local session="${1:-.}" dir layout="${3:-shell}"
  dir="$(cd "${2:-.}" 2>/dev/null && pwd -P)" || { echo "rt: no such directory: $2" >&2; return 1; }
  if [[ "$session" == "." ]]; then
    rex do open path="$dir" layout="$layout"
  else
    rex do open session="$session" path="$dir" layout="$layout"
  fi
}
