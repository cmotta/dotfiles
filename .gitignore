# Vim plugin bundles (installed at runtime)
vim/bundle/

# Machine-local overrides (never committed)
*.local
!*.local.example

# Claude Code local state
.claude/

# Caddy dev proxy: CA/runtime state and all per-machine generated site files.
# Sites are never committed (public repo) — regenerate per host with devproxy.
config/caddy/pki/
config/caddy/data/
config/caddy/*.resolved.plist
config/rex/launchd/*.resolved.plist
config/caddy/sites.d/*.caddy

# OS junk
.DS_Store
